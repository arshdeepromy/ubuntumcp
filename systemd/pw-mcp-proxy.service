[Unit]
Description=Playwright MCP OAuth proxy (public /mcp, gated, -> localhost:8931)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/mcp-bridge
ExecStart=%h/mcp-bridge/.venv/bin/python -m pwproxy
Restart=on-failure
RestartSec=3s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=pw-mcp-proxy

[Install]
WantedBy=default.target
