[Unit]
Description=Cloudflare Tunnel for the MCP Bridge
After=network-online.target mcp-bridge.service
Wants=network-online.target

[Service]
Type=simple
User=MCP_USER
Group=MCP_USER
# TUNNEL_NAME is set by setup-tunnel.sh when it writes this file into place.
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --url http://127.0.0.1:8901 MCP_TUNNEL_NAME
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-tunnel

[Install]
WantedBy=multi-user.target
