[Unit]
Description=Cloudflare Tunnel for the MCP Bridge
After=network-online.target mcp-bridge.service
Wants=network-online.target

[Service]
Type=simple
# MCP_TUNNEL_NAME is substituted by setup-tunnel.sh when it writes this file
# into place; MCP_BRIDGE_PORT must match the port in ~/.mcp-bridge/bridge.env.
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate run --url http://127.0.0.1:8901 MCP_TUNNEL_NAME
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=mcp-tunnel

[Install]
WantedBy=default.target
